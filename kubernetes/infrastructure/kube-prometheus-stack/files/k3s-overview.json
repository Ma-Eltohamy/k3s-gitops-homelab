    {
      "id": 30,
      "title": "Entire Disk (nvme0n1)",
      "description": "Used space across all mounted partitions on nvme0n1, deduplicated per partition. Swap (p7) not included.",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "100 * (1 - sum(max by (device) (node_filesystem_avail_bytes{device=~\"/dev/nvme0n1p.*\"})) / sum(max by (device) (node_filesystem_size_bytes{device=~\"/dev/nvme0n1p.*\"})))",
          "legendFormat": "nvme0n1",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
